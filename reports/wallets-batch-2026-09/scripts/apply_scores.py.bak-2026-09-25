"""T3: write the "## 0 跟單評分" block + frontmatter + §4 data-limits sentence
into every drafts/<addr10>.md, generated purely from copyscore.json (plan §5 T3).

- inserts/replaces "## 0 跟單評分" right after the H1 line
- writes/updates frontmatter: copy_score, copy_score_gate, copy_score_spec,
  copy_score_date, copy_score_window, updated
- strips any leading "NN-" digit prefix from proposed_filename (2026-09-24
  decision: filename carries no score)
- appends/replaces a "跟單評分的極限" bullet in section 6 with the plan §4 sentences
- the generated block contains no [A]-[E] markers (it is built from JSON, not
  from analysis.txt, so there is nothing to mark)

Usage: python apply_scores.py            # all 22
       python apply_scores.py <addr10>    # one wallet, for debugging
"""
import json
import pathlib
import re
import sys
from datetime import datetime, timezone

ROOT = pathlib.Path(__file__).parent.parent
DATA = ROOT / "data"
DRAFTS = ROOT / "drafts"
TODAY = datetime.now(timezone.utc).strftime("%Y-%m-%d")

DATA_LIMIT_SENTENCES = (
    "延遲成本用 Binance 1m 代理／HL 1m 的相對變動估算（保真 0.7–0.9 → 偏樂觀）；"
    "δ 小於 1 分鐘時延遲成本幾乎只剩滑價。"
    "跟單者資金費＝領單者 funding 列（只有前 500 筆）＝下界。"
    "延遲分布是假設值（未有實測）；漏單恢復是模型內的逐事件精算，不是實盤跟單記錄；前瞻分項是同窗口切分。"
)


def build_block(d):
    if d.get("unscorable"):
        lines = [
            f"## 0 跟單評分：**0 / 100**（未通過門檻 —— 無法評分：權益過小）",
            "",
            f"<!-- 由 apply_scores.py 從 copyscore.json 生成，spec {d.get('spec_version', 'v0.5')}，"
            f"docs/plans/copytrade-score.md，{TODAY} -->",
            "",
            f"{d.get('unscorable_reason', '')}（E_min = ${d.get('E_min', 0):,.2f}，"
            f"領單者 W 內權益峰值 = ${d.get('L_peak', 0):,.2f}）。此錢包在整個窗口內權益都低於可跟單門檻，"
            "無法建立有意義的按比例跟單模擬，五面向與門檻皆計 0／FAIL，排名列於最末。",
            "",
        ]
        return "\n".join(lines)

    total = d["total"]
    gate = d["gate"]["overall"]
    g1, g2, g3 = d["gate"]["G1"], d["gate"]["G2"], d["gate"]["G3"]
    D1, D2, D3, D4, D5 = d["D1"], d["D2"], d["D3"], d["D4"], d["D5"]
    win = d["window"]
    dd = d["delay_dist"]

    lines = []
    lines.append(f"## 0 跟單評分：**{total} / 100**（{'通過門檻' if gate else '未通過門檻'}）")
    lines.append("")
    lines.append(f"<!-- 由 apply_scores.py 從 copyscore.json 生成，spec {d.get('spec_version', 'v0.5')}，"
                 f"docs/plans/copytrade-score.md，{TODAY} -->")
    lines.append("")
    lines.append(
        f"模擬窗口 {win['start']} → {win['end']}（{win['days']} 天，全歷史第一筆到最後一筆 perp fill），"
        f"跟單者起始權益 ${d['E0']:,.2f}（＝領單者窗口起點權益），按比例（C_t/L_t）鏡射部位、延遲後市價成交、"
        f"taker 費 {d.get('taker_fee_bps', 4.5):.1f} bps。"
        f"D1 三測試：a 正常跟單（延遲逐事件抽樣，中位數 {dd['median_s']:.0f}s／P95 {dd['p95_s']:.0f}s，固定種子）；"
        f"b 執行壓力（延遲 P95×2、滑價×2、兩者同時三情境取最差）；"
        f"c 漏單恢復（每事件各注入一次故障，直到下一個 60s 對帳 tick 才補齊，逐事件精算，開倉／減倉分開取最差）。"
    )
    stopout_date = d.get("stopout_date")
    lines.append("")
    if stopout_date:
        stopout_lev = d.get("stopout_leverage")
        stopout_lev_str = f"{stopout_lev:.2f}×" if stopout_lev is not None else "—（權益歸零，槓桿未定義）"
        lines.append(f"**模擬跟單者於 {stopout_date} 爆倉**（plan v0.5 §1.4b：C_t ≤ 0 或槓桿 > "
                     f"{d.get('stopout_leverage_threshold', 50):.0f}×；爆倉時槓桿 {stopout_lev_str}，"
                     "當日以收盤價平倉、之後不再跟單）。")
        lines.append("")
    lines.append("| 門檻 | 判準 | 實際 | 結果 |")
    lines.append("|---|---|---|---|")
    lines.append(f"| G1 延遲後仍有收益 | 執行壓力最差情境 net > 0 | ${g1['net']:,.2f}（情境 {g1['worst_stress_scenario']}） | {'通過' if g1['pass'] else '不通過'} |")
    g2_lev_str = f"{g2['peak_leverage']:.2f}×" if g2['peak_leverage'] is not None else "—（權益歸零）"
    g2_actual = f"{g2_lev_str}、{g2['worst_day_frac']:.1%}" + (f"（爆倉於 {stopout_date}）" if stopout_date else "")
    lines.append(f"| G2 庫存風險有限 | 槓桿尖峰 ≤ 3.0× 且 最差日 ≥ −15% | {g2_actual} | {'通過' if g2['pass'] else '不通過'} |")
    lines.append(f"| G3 不依賴少數行情 | 移除最佳 {g3['n_removed_days']} 天後仍 > 0 | ${g3['net_before']:,.2f} → ${g3['net_after']:,.2f} | {'通過' if g3['pass'] else '不通過'} |")
    lines.append("")
    lines.append("| 面向 | 子項 | 得分 | 保留率 r | 關鍵數字 |")
    lines.append("|---|---|---|---|---|")
    lines.append(f"| 跟單可複製性（35） | a 正常跟單（5） | {D1['a']:.2f} | {D1['r_normal']:.3f} | 延遲抽樣 median {dd['median_s']:.0f}s |")
    lines.append(f"|  | b 執行壓力（20） | {D1['b']:.2f} | {D1['r_stress']['worst']:.3f} | i={D1['r_stress']['i']:.3f} ii={D1['r_stress']['ii']:.3f} iii={D1['r_stress']['iii']:.3f} |")
    lines.append(f"|  | c 漏單恢復（10） | {D1['c']:.2f} | {D1['r_miss']['worst']:.3f} | open={D1['r_miss']['open']:.3f} reduce={D1['r_miss']['reduce']:.3f} |")
    d2_lev_str = f"{D2['lev_peak']:.2f}×" if D2['lev_peak'] is not None else "—（權益歸零）"
    lines.append(f"| 下檔控制（30） |  | {D2['score']:.2f} |  | MDD {D2['mdd']:.1%}、最差日 {D2['worst_day_frac']:.1%}、最長回撤 {D2['dd_days']} 天、槓桿尖峰 {d2_lev_str} |")
    lines.append(f"| 獲利穩健性（20） |  | {D3['score']:.2f} |  | 正月占比 {D3['m_hit']:.1%}、rob {D3['rob']:.3f}、conc {D3['conc']:.3f}（主力幣 {D3['dominant_coin']}，{D3['n_w_episodes']} episodes 內 {D3['n_open_w_episodes']} 未平倉） |")
    lines.append(f"| 超額收益（10） |  | {D4['score']:.2f} |  | R_c {D4['R_c']:.3f} vs 風險對齊基準 R_b* {D4['R_b_star']:.3f}，excess {D4['excess']:.3f} |")
    lines.append(f"| 證據品質（5） |  | {D5['score']:.2f} |  | 歷史 {D5['hist_days']:.0f} 天、覆蓋率 {D5['coverage']:.1%}、價格級別 {D5['price_level_frac']:.1%} |")
    lines.append("")

    dims = {"跟單可複製性": D1["score"] / 35, "下檔控制": D2["score"] / 30, "獲利穩健性": D3["score"] / 20,
            "超額收益": D4["score"] / 10, "證據品質": D5["score"] / 5}
    worst_dim = min(dims, key=dims.get)
    failed = [n for n, g in (("G1", g1), ("G2", g2), ("G3", g3)) if not g["pass"]]
    s1 = f"(1) 五面向中「{worst_dim}」相對最弱（{dims[worst_dim]:.0%} 滿分）。"
    s2 = f"(2) 門檻{'全數通過' if gate else '未通過：' + '、'.join(failed)}。"
    s3 = "(3) 延遲成本模型、漏單恢復與前瞻切分皆為模型內假設，非實盤跟單記錄（詳見第 6 章）。"
    lines.append(" ".join([s1, s2, s3]))
    lines.append("")
    return "\n".join(lines)


def upsert_block(text, block):
    # remove an existing "## 0 ..." section (from its heading to the next "## " or EOF)
    text = re.sub(r"^## 0 .*?(?=\n## |\Z)", "", text, count=1, flags=re.M | re.S)
    m = re.search(r"^# .*\n", text, re.M)
    if not m:
        return block + "\n" + text
    insert_at = m.end()
    # skip one blank line right after H1 if present (we re-add exactly one)
    rest = text[insert_at:]
    rest = re.sub(r"^\n+", "", rest)
    return text[:insert_at] + "\n" + block + "\n" + rest


FRONT_KEYS = ["copy_score", "copy_score_gate", "copy_score_spec", "copy_score_date", "copy_score_window"]


def upsert_frontmatter(text, d):
    m = re.match(r"^---\n(.*?)\n---\n", text, re.S)
    if not m:
        return text
    fm = m.group(1)
    for k in FRONT_KEYS + ["updated"]:
        fm = re.sub(rf"^{k}:.*$\n?", "", fm, flags=re.M)
    fm = fm.rstrip("\n")
    fm += f"\nupdated: {TODAY}"
    fm += f"\ncopy_score: {d['total']}"
    fm += f"\ncopy_score_gate: {'PASS' if d['gate']['overall'] else 'FAIL'}"
    fm += f"\ncopy_score_spec: \"{d.get('spec_version', 'v0.5')}\""
    fm += f"\ncopy_score_date: {TODAY}"
    fm += f"\ncopy_score_window: [{d['window']['start']}, {d['window']['end']}]"
    new_front = f"---\n{fm}\n---\n"
    return text[:m.start()] + new_front + text[m.end():]


def strip_filename_prefix(text):
    def repl(m):
        prefix, rest = m.group(1), m.group(2)
        return f'proposed_filename: "{rest}"'
    return re.sub(r'^proposed_filename:\s*"?(\d{2}-)?([^"\n]+)"?\s*$', repl, text, flags=re.M)


def upsert_section6_limits(text):
    m = re.search(r"^## 6 資料極限\s*$", text, re.M)
    if not m:
        return text
    nxt = re.search(r"^## ", text[m.end():], re.M)
    end = m.end() + (nxt.start() if nxt else len(text) - m.end())
    body = text[m.end():end]
    body = re.sub(r"^- (?:\*\*)?跟單評分的極限(?:\*\*)?.*$\n?\n?", "", body, flags=re.M)
    body = body.rstrip("\n") + "\n"
    body += f"- 跟單評分的極限：{DATA_LIMIT_SENTENCES}\n\n"
    return text[:m.end()] + body + text[end:]


def process(addr10):
    jp = DATA / addr10 / "copyscore.json"
    dp = DRAFTS / f"{addr10}.md"
    if not jp.exists():
        return False, f"no copyscore.json for {addr10}"
    if not dp.exists():
        return False, f"no draft for {addr10}"
    d = json.loads(jp.read_text())
    text = dp.read_text()
    block = build_block(d)
    text = upsert_block(text, block)
    text = upsert_frontmatter(text, d)
    text = strip_filename_prefix(text)
    text = upsert_section6_limits(text)
    if "[A]" in block or re.search(r"\[[A-E]\]", block):
        return False, f"{addr10}: generated block contains a section marker — bug"
    dp.write_text(text)
    return True, "ok"


def main():
    addrs = sys.argv[1:] or [a[:10] for a in (ROOT / "addrs.txt").read_text().split()]
    ok, fail = 0, []
    for a in addrs:
        good, msg = process(a)
        print(f"{a}: {'OK' if good else 'FAIL'} {msg}")
        if good:
            ok += 1
        else:
            fail.append((a, msg))
    print(f"\n{ok}/{len(addrs)} applied")
    for a, msg in fail:
        print(f"  ! {a}: {msg}")


if __name__ == "__main__":
    main()
