# .env.cta-b1 — CTA instance B1 (third live instance; new wallet, vol-target
# sizing opt-in). Copy this file to `.env.cta-b1`, fill in the <FILL_ME>
# values, chmod 600, and NEVER commit the filled-in copy (this .example file
# is the only version that belongs in git).
#
# Selected by systemd via a PROCESS env var (set in deploy/hl-cta-b1.service,
# NOT in this file): Environment=CTA_ENV_FILE=/home/ubuntu/vault/.env.cta-b1
# The filename's suffix after the first dot ("cta-b1") becomes INSTANCE_LABEL,
# which derives a fully isolated state file (data/cache/cta-b1_state.json) and
# cache dir (data/cache/cta-b1_live) — this instance cannot collide with
# wallet A (.env.cta -> cta_state.json) or wallet B (.env.cta2 ->
# cta2_state.json). Verified: Path(".env.cta-b1").suffix.lstrip(".") ==
# "cta-b1" (2026-07-14, python3 -c check against the real config.py logic).
#
# Every variable name below is verified against src/hlvault/cta/config.py
# (2026-07-14). Do not rename keys — the engine only reads the exact names
# used by config.py's _env_str/_env_bool/_env_float/_env_int calls.

# ============================================================
# wallet / network — REAL MONEY. Fill in only after the new wallet exists.
# CLAUDE.md 實盤紅線: this file, once filled in, IS a live wallet key. Never
# print it, copy it elsewhere, or load it in a test.
# ============================================================
WALLET_PRIVATE_KEY=<FILL_ME>       # hex private key of the NEW B1 wallet (0x...), owner-only
WALLET_ADDRESS=<FILL_ME>           # the NEW B1 wallet's public address (0x...)
LIVE_TRADING=false                 # keep false until dry-run has been reviewed; owner flips to true
NETWORK=mainnet                    # mainnet | testnet

# ============================================================
# universe — finalized as BTC,ETH,SOL,DOGE,XRP,DOT (2026-07 decision)
# ============================================================
# CRITICAL PRE-FLIGHT BLOCKER (see runbook step 0): src/hlvault/cta/config.py's
# BINANCE_SYMBOLS dict (used by data.py:206 for every klines fetch) currently
# has NO entry for "DOT". As long as that gap is open, this instance WILL
# raise KeyError('DOT') on every rebalance cycle that touches DOT. This must
# be fixed in code (one dict entry, e.g. "DOT": "DOTUSDT") and deployed BEFORE
# `systemctl enable --now hl-cta-b1` — this is a code change to shared
# src/hlvault/cta/config.py (affects all three instances' import), so per
# CLAUDE.md it is NOT something this packaging pass makes silently; the owner
# (or a follow-up dev pass) must approve and land it first. Coinalyze symbol
# resolution for DOT is fine (dynamic lookup via resolve_coinalyze_symbol) —
# only the Binance klines symbol map is missing the entry.
COIN_UNIVERSE=BTC,ETH,SOL,DOGE,XRP,DOT

# ============================================================
# per-side switches — same short-only alpha book as wallet A / wallet B
# ============================================================
ENABLE_LONG=false                  # phase-2b evidence: long leg is deeply negative on 4h — keep off
ENABLE_SHORT=true

# ============================================================
# signal params — MUST match wallet A / phase-2b research params. Do not
# tune per-instance; these define the strategy, not the deployment.
# ============================================================
TIMEFRAME=4h
EMA_FAST=20
EMA_SLOW=50
TREND_WARMUP_BARS=50
CROWD_PCTILE=10                    # p10 config: crowd_long>=90, crowd_short<=10
CROWD_WINDOW_DAYS=90
CROWD_WARMUP_DAYS=30
BARS_PER_DAY=6                     # 4h -> 6 bars/day
FUEL_LOOKBACK_HOURS=24
ATR_PERIOD=14
STOP_ATR_MULT=2.0
MAX_HOLD_DAYS=14

# ============================================================
# sizing / risk
# ============================================================
NOTIONAL_PER_TRADE=300             # owner may change; matches wallet-A/B instance convention ($300/entry)
MAX_GROSS_LEVERAGE=2.0             # owner may change; matches wallet-A/B instance convention (2.0x cap)
MAX_DRAWDOWN_PCT=0.20              # 20% account-level MDD circuit breaker -> flattens everything
MIN_ORDER_NOTIONAL=12              # orders smaller than this (in $) are skipped, not sent
ORDER_SLIPPAGE=0.05                # limit-price slippage allowance fraction

# ============================================================
# vol-target sizing (sub-project L, B1 feature; opt-in, default OFF in code)
# THIS is what makes this instance "B1": entry notional is scaled by
# m = clip(SIGMA_TARGET / sigma_i, SIGMA_CLIP_LO, 1.0) instead of always 1.0.
# Leaving SIGMA_TARGET unset/empty makes this instance byte-for-bit identical
# in sizing behavior to wallet A/B (m==1.0 always) — setting it here is the
# ONE deliberate opt-in for this deployment.
# ============================================================
SIGMA_TARGET=0.60                  # 60% annualized target vol; entries scale down for higher-vol coins
SIGMA_SPAN_BARS=180                # EWMA span (in 4h bars) for the realized-vol estimate; code default
SIGMA_CLIP_LO=0.25                 # floor on the size multiplier (never scales below 25% of NOTIONAL_PER_TRADE)
# SIGMA_CLIP_HI is fixed at 1.0 in code (NOT an env knob) — sizing only ever
# scales DOWN, never up. This is a structural invariant, do not try to set it.

# ============================================================
# beta sleeve — NOT used by B1. B1 is alpha-only (same short-only book as
# wallet A/B, no persistent long sleeve). Leave unset: BETA_TARGET_FRACTION
# defaults to 0 in config.py, which is a guaranteed no-op (no reads, no
# orders, no import-time guard triggered). Do not set BETA_* here unless a
# future decision explicitly adds a beta sleeve to this wallet.
# ============================================================

# ============================================================
# cadence
# ============================================================
SYNC_INTERVAL_SECONDS=300          # engine loop poll interval (--once/--dry-run ignore this)
REBALANCE_INTERVAL_HOURS=4         # matches TIMEFRAME=4h
DATA_STALENESS_HOURS=8             # cross-venue (Binance/Coinalyze) data freshness guard

# ============================================================
# Coinalyze — THREE live instances (cta, cta2, cta-b1) will exist once this
# wallet goes live. All three currently share ONE Coinalyze free-tier budget
# (40 req/min) via .env.research's COINALYZE_API_KEY, unless an instance sets
# its own key here. Pick ONE option before going live:
#
#   Option A (preferred — removes the shared budget entirely):
#     Get a separate Coinalyze API key for B1 and set COINALYZE_API_KEY below.
#     Each instance then has its own 40 req/min budget; no throttle math needed.
#
#   Option B (share the .env.research key across all three):
#     Leave COINALYZE_API_KEY unset here (falls through to .env.research), but
#     set COINALYZE_THROTTLE_SECONDS on ALL THREE instance env files (.env.cta,
#     .env.cta2, .env.cta-b1) so the COMBINED worst-case rate stays under the
#     40 req/min cap with a safety margin. With 3 instances sharing one key,
#     each instance's throttle should be roughly >= 5.6s (3 instances x 60/5.6
#     ~= 32 req/min combined, ~20% under the cap) — check what .env.cta and
#     .env.cta2 are CURRENTLY set to (they may already be tuned for a 2-way
#     share from the wallet-B rollout) and raise all three together. Do not
#     raise only this file — the cap is on the combined rate, not per-file.
# ============================================================
COINALYZE_API_KEY=<FILL_ME_OR_LEAVE_BLANK>   # blank = falls through to .env.research's key (Option B)
COINALYZE_THROTTLE_SECONDS=1.6               # code default (single-instance budget) — see Option A/B above

# ============================================================
# notify
# ============================================================
TELEGRAM_BOT_TOKEN=<FILL_ME>       # can reuse the existing bot token, or a dedicated one
TELEGRAM_CHAT_ID=<FILL_ME>         # alerts are prefixed "CTA-B1 " (INSTANCE_LABEL.upper()) — distinguishable in-chat
