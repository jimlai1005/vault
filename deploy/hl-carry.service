[Unit]
Description=Hyperliquid funding-carry bot (hlvault.carry)
Documentation=https://github.com/jimlai1005/vault
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu

WorkingDirectory=/home/ubuntu/vault
EnvironmentFile=/home/ubuntu/vault/.env.carry

ExecStart=/home/ubuntu/vault/.venv/bin/hl-carry

Restart=on-failure
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

MemoryMax=256M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hl-carry

[Install]
WantedBy=multi-user.target
