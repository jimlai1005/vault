[Unit]
Description=Hyperliquid CTA vol-target sizing bot (hlvault.cta, instance cta-b1)
Documentation=https://github.com/jimlai1005/vault
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu

WorkingDirectory=/home/ubuntu/vault
Environment=CTA_ENV_FILE=/home/ubuntu/vault/.env.cta-b1
EnvironmentFile=/home/ubuntu/vault/.env.cta-b1

ExecStart=/home/ubuntu/vault/.venv/bin/hl-cta

Restart=on-failure
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

MemoryMax=256M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hl-cta-b1

[Install]
WantedBy=multi-user.target
