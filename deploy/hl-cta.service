[Unit]
Description=Hyperliquid independent CTA short-carry bot (hlvault.cta)
Documentation=https://github.com/jimlai1005/vault
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu

WorkingDirectory=/home/ubuntu/vault
EnvironmentFile=/home/ubuntu/vault/.env.cta

ExecStart=/home/ubuntu/vault/.venv/bin/hl-cta

Restart=on-failure
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

MemoryMax=256M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hl-cta

[Install]
WantedBy=multi-user.target
